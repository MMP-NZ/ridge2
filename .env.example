# Copy to .env.local for local dev. Never commit real values.

# Postgres connections for the app. Both roles are non-superuser with RLS
# enforced (no BYPASSRLS) — see src/db/roles.sql and src/db/migrations/0001_rls_policies.sql.
#
# ridge_auth: pre-authentication lookups only (find a user by email, verify/
#   create a session by token hash). Cannot see tenant business data.
DATABASE_AUTH_URL=postgres://ridge_auth@localhost:5432/ridge_dev
# ridge_app: every authenticated request. Tenant context is set per-request
#   via SET LOCAL inside a transaction — see src/db/client.ts.
DATABASE_URL=postgres://ridge_app@localhost:5432/ridge_dev

# Separate connection used only for running migrations (owns the schema,
# needed to run CREATE POLICY / ALTER TABLE ... ENABLE ROW LEVEL SECURITY).
DATABASE_MIGRATE_URL=postgres://admin@localhost:5432/ridge_dev

# Postgres connections used by the vitest suite. Point at a disposable DB.
DATABASE_TEST_AUTH_URL=postgres://ridge_auth@localhost:5432/ridge_test
DATABASE_TEST_URL=postgres://ridge_app@localhost:5432/ridge_test
DATABASE_TEST_MIGRATE_URL=postgres://admin@localhost:5432/ridge_test

# Session cookie signing/hashing. Generate with: openssl rand -hex 32
SESSION_SECRET=

# AES-256-GCM key used to encrypt long-lived credentials at rest (TOTP
# secrets, Meta Page access tokens). Generate with: openssl rand -hex 32
SECRET_ENCRYPTION_KEY=

# Set to "false" only in production — everywhere else, no message is ever
# sent to a real person (CLAUDE.md non-negotiable). See src/lib/messaging/transport.ts.
LOG_ONLY_TRANSPORT=true

# Real SMS/email sends (only used when LOG_ONLY_TRANSPORT=false).
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# Base URL used to build links in outbound messages (booking links, etc)
# and OAuth redirect URIs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta (Facebook) Developer App — requires a Juno Logic-owned app, business
# verified and approved for leads_retrieval/pages_manage_metadata/
# pages_show_list/pages_read_engagement/ads_management. Doesn't exist yet;
# leave blank until it does (see docs/decisions.md).
META_APP_ID=
META_APP_SECRET=
# Any random string you choose — Meta echoes it back during webhook
# subscription setup so you can prove the request came from you configuring
# the webhook, not a stranger. Generate with: openssl rand -hex 20
META_WEBHOOK_VERIFY_TOKEN=
META_GRAPH_API_VERSION=v21.0

# Where the low-balance ad spend alert emails Juno Logic staff (no admin
# console yet — see docs/build-plan.md M7).
JUNO_OPS_EMAIL=

# Site visit photos. LOCAL_PHOTO_STORE defaults to true and writes under
# PHOTO_STORE_DIR (default .photos/, gitignored) — the same "safe by
# default" shape as LOG_ONLY_TRANSPORT above. Set it to "false" only where
# a real bucket exists. The bucket is private: photos are served back
# through the app so RLS decides who may see a roof, never by public URL.
LOCAL_PHOTO_STORE=true
PHOTO_STORE_DIR=
# Auckland, the same region as everything else (CLAUDE.md: data hosted in
# NZ). Doesn't exist yet — leave blank until it does.
PHOTO_S3_BUCKET=
AWS_REGION=ap-southeast-6
