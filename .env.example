# Copy to .env.local for local dev. Never commit real values.

# Postgres connections for the app. Both roles are non-superuser with RLS
# enforced (no BYPASSRLS) — see src/db/roles.sql and src/db/migrations/0001_rls_policies.sql.
#
# ridge_auth: pre-authentication lookups only (find a user by email, verify/
#   create a session by token hash). Cannot see tenant business data.
DATABASE_AUTH_URL=postgres://ridge_auth@localhost:5432/ridge_dev
# ridge_app: every authenticated request. Tenant context is set per-request
#   via SET LOCAL inside a transaction — see src/db/client.ts.
DATABASE_URL=postgres://ridge_app@localhost:5432/ridge_dev

# Separate connection used only for running migrations (owns the schema,
# needed to run CREATE POLICY / ALTER TABLE ... ENABLE ROW LEVEL SECURITY).
DATABASE_MIGRATE_URL=postgres://admin@localhost:5432/ridge_dev

# Postgres connections used by the vitest suite. Point at a disposable DB.
DATABASE_TEST_AUTH_URL=postgres://ridge_auth@localhost:5432/ridge_test
DATABASE_TEST_URL=postgres://ridge_app@localhost:5432/ridge_test
DATABASE_TEST_MIGRATE_URL=postgres://admin@localhost:5432/ridge_test

# Session cookie signing/hashing. Generate with: openssl rand -hex 32
SESSION_SECRET=

# AES-256-GCM key used to encrypt TOTP secrets at rest. Generate with: openssl rand -hex 32
TOTP_ENCRYPTION_KEY=

# Set to "false" only in production — everywhere else, no message is ever
# sent to a real person (CLAUDE.md non-negotiable). See src/lib/messaging/transport.ts.
LOG_ONLY_TRANSPORT=true

# Real SMS/email sends (only used when LOG_ONLY_TRANSPORT=false).
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
CLICKSEND_FROM=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_FROM_EMAIL=

# Base URL used to build links in outbound messages (booking links, etc).
NEXT_PUBLIC_APP_URL=http://localhost:3000
